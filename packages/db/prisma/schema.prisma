generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  projects Project[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime
  updatedAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String? // important for octakit
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum Framework {
  NEXTJS
  REACT
  VITE
  NODE
  NONE
}

model Project {
  id             String     @id @default(cuid())
  name           String
  description    String?
  repoUrl        String
  owner          String
  repoName       String
  branch         String     @default("main")
  framework      Framework? @default(NONE)
  buildCommand   String?
  outputDir      String?
  rootDir        String?    @default("./")
  installCommand String?    @default("npm install")
  isDeleted      Boolean    @default(false)

  /// Pins the project subdomain to one deployment instead of "latest
  /// COMPLETED" — this is what a rollback sets. Deliberately a plain id rather
  /// than a relation: deployments are soft-deleted, so the proxy has to check
  /// the target is still servable anyway and falls back to latest if not.
  /// Cleared automatically when a newer build completes, so shipping a fix
  /// after a rollback doesn't silently do nothing.
  activeDeploymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deployments Deployment[]
  envVars     EnvVar[]

  // Every project list is "mine, newest first".
  @@index([userId, createdAt])
  @@map("project")
}

/// Build-time environment variables injected into the build container as a
/// `.env` file. `value` is never stored in plaintext — it holds the ciphertext
/// produced by `encryptSecret()` in @repo/shared and is only decrypted by
/// Shipyard when a build runs.
model EnvVar {
  id        String   @id @default(cuid())
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("env_var")
}

enum DeploymentStatus {
  QUEUED
  CLONING
  BUILDING
  FAILED
  COMPLETED
  CANCELLED
}

model Deployment {
  id        String           @id @default(cuid())
  projectId String
  branch    String           @default("main")
  /// DNS-safe form of `branch`, resolved by the proxy for branch previews at
  /// `<branchSlug>--<projectId>`. Stored rather than derived because slugging is
  /// lossy — two branch names can share a slug, and the URL has to resolve
  /// against whatever was actually stored.
  branchSlug String?
  status    DeploymentStatus @default(QUEUED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  isDeleted Boolean          @default(false)

  project Project         @relation(fields: [projectId], references: [id])
  logs    DeploymentLog[]

  // Deployment lists, and the proxy's "latest COMPLETED for this project".
  @@index([projectId, createdAt])
  // The proxy's branch-preview lookup.
  @@index([projectId, branchSlug, createdAt])
  @@map("deployment")
}

model DeploymentLog {
  id           String   @id @default(cuid())
  deploymentId String
  message      String
  timestamp    DateTime @default(now())
  isDeleted    Boolean  @default(false)

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  // Log replay reads one deployment's lines in timestamp order.
  @@index([deploymentId, timestamp])
  @@map("deployment_log")
}
