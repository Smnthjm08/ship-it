# ShipIt environment
#
# Copy to `.env` at the repo root — every app reads from this one file, and
# Turborepo forwards these to each task (see `globalEnv` in turbo.json). A
# variable that is not listed there is stripped before a task runs, so add it
# to both places when you introduce a new one.
#
# Ports: web 3000 · backend 3002 · ws-server 3003 · proxy 8001

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

NODE_ENV="development"

# Postgres. Prisma connects through @prisma/adapter-pg.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shipit"

# Redis. Both `backend` and `shipyard` call connectRedis() at startup and will
# not boot without it.
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Auth (better-auth + GitHub OAuth)
# ---------------------------------------------------------------------------

# openssl rand -hex 32
BETTER_AUTH_SECRET=""

# Points at the WEB app — it serves /api/auth, not the backend. This must match
# the OAuth App callback URL character for character (see README).
BETTER_AUTH_URL="http://localhost:3000"

# Same value, exposed to the browser bundle. NEXT_PUBLIC_ prefix is required:
# a bare process.env var is undefined client-side and fails silently.
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# From an OAuth App (not a GitHub App — see README). Needs the `repo` scope so
# Shipyard can clone private repositories.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional. 32-byte key (openssl rand -hex 32) encrypting project env vars at
# rest. Derived from BETTER_AUTH_SECRET when unset — changing either one makes
# already-stored values undecryptable, which fails the build with an explicit
# message rather than deploying without them.
ENV_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Service URLs (browser-facing, so NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_BASE_URL="http://localhost:3002"

# Live build-log stream. Defaults to ws://localhost:3003 when unset.
NEXT_PUBLIC_WS_URL="ws://localhost:3003"

# ---------------------------------------------------------------------------
# Object storage — any S3-compatible service (AWS, Cloudflare R2, MinIO).
# The bucket must already exist; ShipIt does not create it.
# ---------------------------------------------------------------------------

AWS_ACCESS_KEY=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT=""
AWS_BUCKET_NAME=""
AWS_REGION=""

# ---------------------------------------------------------------------------
# Proxy — resolves <subdomain> to a deployment and serves it from S3
# ---------------------------------------------------------------------------

PROXY_PORT="8001"

# Base domain whose direct children resolve, e.g. "shipit.dev" makes
# <id>.shipit.dev routable. Leave empty for local dev, where any
# <label>.localhost works. Keep in sync with NEXT_PUBLIC_DEPLOY_HOST.
DEPLOY_BASE_DOMAIN=""

# How the web app builds the public URL it shows you. Must match
# DEPLOY_BASE_DOMAIN.
NEXT_PUBLIC_DEPLOY_HOST="localhost:8001"

# ---------------------------------------------------------------------------
# Optional tuning — every one of these has a working default
# ---------------------------------------------------------------------------

# Backend HTTP port. Default 3002.
# PORT="3002"

# ws-server port. Default 3003.
# WS_PORT="3003"

# Port the shipyard worker serves GET /health on. Default 3004.
# SHIPYARD_HEALTH_PORT="3004"

# Hard limit on a single build before the container is stopped. Default 600000
# (10 minutes).
# BUILD_TIMEOUT_MS="600000"

# How long the proxy memoises a subdomain lookup. A fresh deployment can take
# this long to become reachable. Default 30000.
# PROXY_ROUTE_CACHE_TTL_MS="30000"

# Same, for lookups that found nothing. Default 5000.
# PROXY_ROUTE_CACHE_MISS_TTL_MS="5000"

# Log verbosity for backend and shipyard: trace|debug|info|warn|error
# Defaults to debug in development, info in production.
LOG_LEVEL=debug
